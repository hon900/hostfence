# Inactive example: GitHub only reads .github/dependabot.yml.
# Enable only after the maintainer explicitly chooses recurring update PRs.
# This does not enable Dependabot alerts/security updates in repository settings.
version: 2
updates:
  - package-ecosystem: npm
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 3
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: monthly
    open-pull-requests-limit: 2
